<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>s1_sensor_bridge</name>
  <version>0.0.1</version>
  <description>Bridge package for S1 sensor (dual fisheye cameras + Livox MID-360 LiDAR)</description>
  <maintainer email="924431601@qq.com">maoliang</maintainer>
  <license>GPL-3.0</license>

  <depend>rclpy</depend>
  <exec_depend>lidars1</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
